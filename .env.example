# LLM 配置（复制为 .env.local 后填写）
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxx

# OpenAI 兼容端点；用 DeepSeek 时改为 https://api.deepseek.com/v1
OPENAI_BASE_URL=https://api.deepseek.com/v1

# 模型名
MODEL_NAME=deepseek-v4-flash

# 单次请求超时（毫秒，可选）
LLM_TIMEOUT_MS=60000

# ── 语音识别（备选通道，可选）────────────────────────────
# 浏览器内置识别（Chrome / Edge）无需以下配置。
# 仅在浏览器不支持、或需要使用云端 ASR 时启用（需 OpenAI 兼容的转写端点）。
# DeepSeek 端点不支持 /audio/transcriptions，请勿填 DeepSeek。
# ASR_BASE_URL=https://api.groq.com/openai/v1
# ASR_API_KEY=gsk_xxxxxxxx
# ASR_MODEL=whisper-large-v3
# ASR_LANGUAGE=en
