# LLM 配置（复制为 .env.local 后填写）
# ⚠️ 下面默认值是占位符，必须换成你自己的真实配置，否则页面顶部会出现红色「模型未连通」提示。
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxx

# OpenAI 兼容端点。注意：BASE_URL 与 MODEL_NAME 必须属于同一家服务商！
#   DeepSeek 官方 → https://api.deepseek.com/v1        + deepseek-chat
#   OpenAI       → https://api.openai.com/v1           + gpt-4o-mini
#   中转/代理     → 代理商提供的地址                     + 代理文档里的模型名
OPENAI_BASE_URL=https://api.deepseek.com/v1

# 模型名
MODEL_NAME=deepseek-chat

# 单次请求超时（毫秒，可选）
LLM_TIMEOUT_MS=60000
# 单次模型调用超时：演示场景宁可快速失败重试，也别让评委干等
LLM_REQUEST_TIMEOUT_MS=25000

# ── 语音识别（备选通道，可选）────────────────────────────
# 浏览器内置识别（Chrome / Edge）无需以下配置。
# 仅在浏览器不支持、或需要使用云端 ASR 时启用（需 OpenAI 兼容的转写端点）。
# DeepSeek 端点不支持 /audio/transcriptions，请勿填 DeepSeek。
# ASR_BASE_URL=https://api.groq.com/openai/v1
# ASR_API_KEY=gsk_xxxxxxxx
# ASR_MODEL=whisper-large-v3
# ASR_LANGUAGE=en

# 头像服务（可选）：默认使用 DiceBear 公共 API，无需密钥。
# 公共服务限非商业使用；商业部署请改用自托管 DiceBear API。
# AVATAR_API_BASE_URL=https://api.dicebear.com/10.x
